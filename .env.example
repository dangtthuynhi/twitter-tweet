# ===== Bat buoc =====
# Lay tai https://twitterapi.io (Dashboard -> API Key)
TWITTERAPI_KEY=

# Tai khoan X/Twitter dung de dang bai
TW_USERNAME=your_handle_khong_co_@
TW_EMAIL=you@example.com
TW_PASSWORD=your_password

# Proxy residential TINH (static). twitterapi.io BAT BUOC field nay.
# Dinh dang: http://user:pass@ip:port
# Phai dung DUY NHAT 1 proxy co dinh cho ca login lan post.
# Doi proxy giua chung = bot phai login lai = dau hieu X canh giac nhat.
TW_PROXY=http://user:pass@ip:port

# Co ca list proxy? Dan vao day (cach nhau bang dau phay) hoac tao content/proxies.txt,
# roi chay `node src/cli.js proxies` de cham diem va chon ra cai tot nhat.
# Day CHI dung cho viec chon — bot luon chay bang TW_PROXY o tren.
TW_PROXY_LIST=

# ===== Tuy chon =====
# Neu bat 2FA: dan SECRET KEY (chuoi base32 luc quet QR), KHONG phai ma 6 so
TW_TOTP_SECRET=

# ===== Duong vong khi /twitter/user_login_v2 hong =====
# Tu lay cookie tu trinh duyet da dang nhap X, dat vao day de BO QUA buoc login.
# Cach lay: F12 -> Application -> Cookies -> https://x.com -> copy auth_token va ct0
# Dang: auth_token=xxx; ct0=yyy
# CANH BAO: auth_token la chia khoa toan quyen vao tai khoan. Ai co no thi
# dieu khien duoc acc cua ban. Khong commit, khong gui cho ai, khong dan len chat.
TW_LOGIN_COOKIES=

# ===== Nguon bai dang =====
SOURCE=file               # file = queue tay | watch = retweet bai moi cua account khac | both
TWEETS_FILE=content/tweets.txt

# ===== Che do watch: tu retweet bai moi cua cac account =====
# Danh sach account (khong can @). De trong thi doc tu content/accounts.txt
WATCH_ACCOUNTS=
WATCH_INTERVAL=30m        # nhip quet co ban cho moi account
WATCH_ADAPTIVE=true       # TU DIEU CHINH nhip theo tan suat dang that -> tiet kiem nhat
WATCH_MAX_AGE=6h          # bo qua bai cu hon moc nay (tranh retweet bai nguoi ta dang hom kia)
WATCH_INCLUDE_REPLIES=false
WATCH_INCLUDE=            # chi lay bai co chua 1 trong cac tu nay, vd: #hashtag,tu khoa
WATCH_EXCLUDE=            # loai bai co chua cac tu nay, vd: giveaway,airdrop
WATCH_QUEUE_CAP=200       # tran hang doi cho retweet

# ===== Theo doi hashtag (dashboard) =====
# Danh sach hashtag muon do, cach nhau dau phay. Dung duoc ca cu phap tim kiem cua X.
WATCH_HASHTAGS=
# Toi da bao nhieu trang moi lan quet (20 tweet/trang).
# 1 la re nhat va thuong du: quet tang dan nen hashtag it bai chi tra ~$0.00015/lan.
# Tang len 2-3 neu muon dem chinh xac ca nhung hashtag nhieu bai hon (tra tien theo).
HASHTAG_PAGES=1

# Lich dang
POST_INTERVAL=4h          # khoang cach giua 2 tweet: 30s / 45m / 4h / 1d
POST_JITTER=20m           # lech ngau nhien +/- de trong tu nhien hon
POST_DAYS=                # chi dang vao cac thu nay: fri | mon,wed,fri | t6 | 1-5. Trong = moi ngay
POST_HOURS=7-23           # chi dang trong khung gio nay (gio may local), de trong = ca ngay
MAX_PER_DAY=8             # tran so tweet moi ngay
MAX_PER_WINDOW=0          # tran so tweet trong 30 phut (X chia han muc theo khung nua tieng). 0 = tat
SPREAD=false              # true = bo qua POST_INTERVAL, tu rai deu MAX_PER_DAY trong POST_HOURS
ORDER=sequential          # sequential | random
LOOP_QUEUE=false          # true = het queue thi quay lai dang tu dau
POST_ON_START=true        # true = dang ngay 1 bai khi chay `npm start`

# An toan
DRY_RUN=false             # true = chi in ra, khong goi API that
SESSION_TTL=7d            # cache login_cookie bao lau truoc khi login lai
LOG_LEVEL=info            # debug | info | warn | error
